    "firebase": "^11.5.0",
    "marked": "^15.0.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.4.0",
    "sweetalert2": "^11.17.2",
    "tailwindcss": "^4.0.17"
